// Legacy v0.2 architecture sketch. Canonical v0.3 syntax: syntax_v03.ngj.
// Design example. App adapters below are required contracts, not implemented SDKs.
module payment.service

import std.telemetry.event
import app.payment.{PaymentGateway, FraudRead, PaymentRequest, PaymentId,
                    PaymentError, checkFraud, chargeRecoverable}

event PaymentCompleted(paymentId: Long)

// PaymentGateway is a host-issued capability, not a URL constructed by this code.
// chargeRecoverable owns durable intent, idempotency and Unknown reconciliation.
@trace("payment.process")
pub fn processPayment(gateway: &PaymentGateway, fraud: &FraudRead,
                      req: PaymentRequest)
    -> Result<PaymentId, PaymentError> ! { FraudRead, PaymentWrite }
{
    // Do not reserve/charge in parallel before the fraud decision is known.
    let decision = checkFraud(fraud, &req)?
    if !decision.isSafe {
        return Err(PaymentError::FraudDetected)
    }

    // Gateway receives the Secret token through its approved sink; no expose().
    // A timeout may return OutcomeUnknown(operationId), not a definite failure.
    let receipt = chargeRecoverable(gateway, req)?
    emit PaymentCompleted(receipt.paymentId.val)
    Ok(receipt.paymentId)
}
