// v0.3 syntax example
package example.syntax;

public record Amount(value: Long);

public enum InputError {
    Negative()
}

public fn validate(value: Long) -> Result<Amount, InputError> effects() {
    if (value < 0L) {
        return Err(InputError.Negative());
    } else {
        return Ok(Amount(value));
    }
}

public fn checkedValue(value: Long) -> Result<Long, InputError> effects() {
    val amount = validate(value)?;
    return Ok(amount.value);
}

public fn incomplete(value: Long) -> Result<Amount, InputError> effects() {
    ?validated_amount
}
