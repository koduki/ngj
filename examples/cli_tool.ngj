// Legacy v0.2 architecture sketch. Canonical v0.3 syntax: syntax_v03.ngj.
// Design example. Input is split at line boundaries, not arbitrary byte chunks.
module cli.main

import std.cli.parseArgs
import std.concurrent.{TaskError, ScopeError}
import std.fs.{FsRead, readOwnedBytes}
import std.console.{Console, writeLine}
import app.logs.{partitionLines, countErrors, combine, SummaryReport}

@derive(CliArgs)
data CliConfig(inputFile: String, workers: Int = 8)

// Host supplies capabilities; source code cannot mint them from a path/string.
pub fn run(fs: &FsRead, out: &Console, rawArgs: List<String>)
    -> Result<Int, CliError> ! { FsRead, ConsoleWrite }
{
    let config = parseArgs<CliConfig>(rawArgs)
        .mapErr(|_| CliError::Arguments)?
    if config.workers < 1 || config.workers > 64 {
        return Err(CliError::Arguments)
    }
    let content = readOwnedBytes(fs, config.inputFile)
        .mapErr(|_| CliError::Input)?
    // Bounded partitions, preserving final unterminated line and UTF-8 boundaries.
    let chunks = partitionLines(content.asBytes(), config.workers)

    let report = scope {
        // Eager map starts all tasks before joining; views borrow content.
        let tasks = chunks.map(|chunk| fork { countErrors(chunk) })
        let mut total = SummaryReport(0, 0)
        for task in tasks {
            let partial = task.join().mapErr(|e| CliError::Task(e))?
            total = combine(total, partial).mapErr(|_| CliError::Overflow)?
        }
        total
    }.mapErr(|e| CliError::Scope(e))?

    writeLine(out, report.toJson()).mapErr(|_| CliError::Output)?
    Ok(0)
}

pub enum CliError {
    Arguments,
    Input,
    Output,
    Overflow,
    Task(detail: TaskError),
    Scope(detail: ScopeError)
}
