// Legacy v0.2 architecture sketch. Canonical v0.3 syntax: syntax_v03.ngj.
// Design example. Trusted adapters isolate JDBC/credentials and HTTP capabilities.
module app.api

import std.http.{Request, Response, Status}
import std.json.fromJson
import std.telemetry.event
import app.users.{UserId, CreateUserReq,
                  UserRead, UserWrite, validateCreateUser,
                  findById, createUser, jsonResponse}

@derive(JsonCodec)
data ErrorRes(code: String, message: String)
event UserCreated(userId: Long)

pub fn handleGetUser(repo: &UserRead, req: Request)
    -> Response ! { DbRead }
{
    let id = match req.pathParam("id").andThen(|s| s.parseLong().ok()) {
        Some(value) => UserId(value),
        None => return jsonResponse(Status::BadRequest,
            ErrorRes("INVALID_ID", "User ID must be a number"))
    }
    match findById(repo, id) {
        Ok(Some(user)) => jsonResponse(Status::Ok, user),
        Ok(None) => jsonResponse(Status::NotFound,
            ErrorRes("NOT_FOUND", "User not found")),
        Err(_) => jsonResponse(Status::InternalServerError,
            ErrorRes("INTERNAL_ERROR", "Database error"))
    }
}

pub fn handleCreateUser(repo: &UserWrite, req: Request)
    -> Response ! { DbWrite }
{
    // Parsing alone does not establish business validity or grant authority.
    let body = match fromJson<CreateUserReq>(req.bodyBytes()) {
        Ok(value) => value,
        Err(_) => return jsonResponse(Status::BadRequest,
            ErrorRes("INVALID_JSON", "Invalid request"))
    }
    let validated = match validateCreateUser(body) {
        Ok(value) => value,
        Err(_) => return jsonResponse(Status::BadRequest,
            ErrorRes("INVALID_INPUT", "Invalid user data"))
    }
    // Adapter handles password hashing and JDBC; this module cannot unwrap Secret.
    match createUser(repo, validated) {
        Ok(user) => {
            emit UserCreated(user.id)
            jsonResponse(Status::Created, user)
        },
        Err(_) => jsonResponse(Status::InternalServerError,
            ErrorRes("INTERNAL_ERROR", "Database error"))
    }
}

// Host bootstrapping, routing and capability issuance live outside this generated
// module. No raw DriverManager, unsafe block, or aot_verified self-attestation.
