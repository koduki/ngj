// Design example, not compiler-validated. See examples/README.md.
module net.protocol

import std.io.{Bytes, ByteOrder, BoundsError}

pub data PacketFrame<'a>(streamId: Int, flags: Byte, payload: Bytes<'a>)

pub enum ParseError {
    IncompleteHeader,
    NegativeLength,
    IncompletePayload,
    Bounds(detail: BoundsError)
}

// Views in the result retain the input lifetime. The backing owner must survive.
pub fn parseFrames<'a>(raw: Bytes<'a>)
    -> Result<List<PacketFrame<'a>>, ParseError> ! {}
{
    let frames = build MutableList<PacketFrame<'a>> {
        let mut cursor: Long = 0
        while cursor < raw.len() {
            // cursor <= len is the loop invariant; subtraction cannot overflow.
            let remaining = raw.len() - cursor
            if remaining < 9 { return Err(ParseError::IncompleteHeader) }

            let streamId = raw.readInt(cursor, ByteOrder::BigEndian)
                .mapErr(|e| ParseError::Bounds(e))?
            let flags = raw.readByte(cursor + 4)
                .mapErr(|e| ParseError::Bounds(e))?
            let signedLength = raw.readInt(cursor + 5, ByteOrder::BigEndian)
                .mapErr(|e| ParseError::Bounds(e))?
            if signedLength < 0 { return Err(ParseError::NegativeLength) }

            let length = signedLength.toLong()
            let payloadStart = cursor + 9
            // Check by subtraction BEFORE adding length, including hostile lengths.
            if length > raw.len() - payloadStart {
                return Err(ParseError::IncompletePayload)
            }
            let payload = raw.slice(payloadStart, length)
                .mapErr(|e| ParseError::Bounds(e))?
            this.add(PacketFrame(streamId, flags, payload))
            cursor = payloadStart + length
        }
        this
    }
    Ok(frames)
}
