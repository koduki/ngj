// Match completion test for AI pilot evaluation
// Tests understanding of exhaustive matching
// Per EBNF spec: variant = IDENT "(" [ parameters ] ")"
package pilot.match_complete;

public enum Color {
    Red(),
    Green(),
    Blue()
}

// The match is incomplete - AI should detect missing cases
public fn colorCode(c: Color) -> Int effects() {
    return match (c) {
        case Red() => { 1 },
        case Green() => { ?greenCode }
    };
}
