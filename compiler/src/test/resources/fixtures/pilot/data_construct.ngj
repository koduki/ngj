// Data construction test for AI pilot evaluation
// Tests understanding of field types and construction
package pilot.data_construct;

public record Point(x: Int, y: Int);

public record Rectangle(topLeft: Point, bottomRight: Point);

public fn makeOrigin() -> Point effects() {
    ?originPoint
}

public fn makeRect(width: Int, height: Int) -> Rectangle effects() {
    val origin: Point = makeOrigin();
    val corner: Point = Point(width, height);
    ?rectangle
}
