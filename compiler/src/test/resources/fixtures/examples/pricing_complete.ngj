// Pricing calculation - complete version (simplified for MVP)
// Demonstrates basic calculations with v0.3 syntax
package example.pricing;

public fn itemSubtotal(basePrice: Int, quantity: Int) -> Int effects() {
    basePrice * quantity
}

public fn applyDiscount(amount: Int, percentOff: Int) -> Int effects() {
    amount - (amount * percentOff / 100)
}

public fn calculateTax(amount: Int, taxRate: Int) -> Int effects() {
    amount * taxRate / 100
}

public fn calculateTotal(basePrice: Int, quantity: Int, discountPct: Int, taxRate: Int) -> Int effects() {
    val subtotal: Int = basePrice * quantity;
    val discounted: Int = subtotal - (subtotal * discountPct / 100);
    val tax: Int = discounted * taxRate / 100;
    discounted + tax
}

public fn demoCalculation() -> Int effects() {
    calculateTotal(1000, 2, 5, 10)
}
