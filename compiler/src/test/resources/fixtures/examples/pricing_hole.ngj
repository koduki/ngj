// Pricing calculation - version with typed holes
// AI agent can fill in the holes based on type context

module example.pricing_hole

// Calculate item subtotal
// Hole: implement the multiplication
pub fn itemSubtotal(basePrice: Int, quantity: Int) -> Int ! {} {
    ?subtotalCalc
}

// Apply percentage discount
// Hole: implement the discount calculation
pub fn applyDiscount(amount: Int, percentOff: Int) -> Int ! {} {
    ?discountLogic
}

// Calculate tax
// Hole: implement the tax calculation
pub fn calculateTax(amount: Int, taxRate: Int) -> Int ! {} {
    ?taxFormula
}

// Calculate total with discount and tax
pub fn calculateTotal(basePrice: Int, quantity: Int, discountPct: Int, taxRate: Int) -> Int ! {} {
    let subtotal: Int = itemSubtotal(basePrice, quantity)
    let discounted: Int = applyDiscount(subtotal, discountPct)
    let tax: Int = calculateTax(discounted, taxRate)
    ?finalTotal
}
