// Pricing calculation - version with typed holes
// AI agent can fill in the holes based on type context
package example.pricing_hole;

public fn itemSubtotal(basePrice: Int, quantity: Int) -> Int effects() {
    ?subtotalCalc
}

public fn applyDiscount(amount: Int, percentOff: Int) -> Int effects() {
    ?discountLogic
}

public fn calculateTax(amount: Int, taxRate: Int) -> Int effects() {
    ?taxFormula
}

public fn calculateTotal(basePrice: Int, quantity: Int, discountPct: Int, taxRate: Int) -> Int effects() {
    val subtotal: Int = itemSubtotal(basePrice, quantity);
    val discounted: Int = applyDiscount(subtotal, discountPct);
    val tax: Int = calculateTax(discounted, taxRate);
    ?finalTotal
}
