// Pricing calculation - version with type errors
// Demonstrates various type mismatches the type checker catches
package example.pricing_error;

// Error: returning String when Int expected
public fn itemSubtotal(basePrice: Int, quantity: Int) -> Int effects() {
    "not a number"
}

// Error: wrong arithmetic types
public fn calculateTax(amount: Int, taxRate: Int) -> Int effects() {
    amount * "10" / 100
}

// Error: type mismatch in return
public fn applyDiscount(amount: Int, percentOff: Int) -> Int effects() {
    true
}

// Error: wrong argument types in function call
public fn calculateTotal(basePrice: Int, quantity: Int) -> Int effects() {
    itemSubtotal("hello", quantity)
}
