// Short-circuit logic
package test.logic;

public fn andTest(a: Bool, b: Bool) -> Bool effects() {
    a && b
}

public fn orTest(a: Bool, b: Bool) -> Bool effects() {
    a || b
}

public fn notTest(a: Bool) -> Bool effects() {
    !a
}

public fn complex(a: Bool, b: Bool, c: Bool) -> Bool effects() {
    (a && b) || (!c)
}
