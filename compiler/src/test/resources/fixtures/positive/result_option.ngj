// Result and Option usage (v0.3 syntax)
package test.result;

public record DivError(message: String);

public fn safeDivide(a: Int, b: Int) -> Result<Int, DivError> effects() {
    if (b == 0) {
        Err(DivError("Division by zero"))
    } else {
        Ok(a / b)
    }
}

public fn doubleOrZero(opt: Option<Int>) -> Int effects() {
    match (opt) {
        case Some(value) => { value * 2 },
        case None() => { 0 }
    }
}
