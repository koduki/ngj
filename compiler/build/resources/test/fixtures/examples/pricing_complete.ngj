// Pricing calculation - complete version (simplified for MVP)
// Demonstrates basic calculations

module example.pricing

// Calculate item subtotal
pub fn itemSubtotal(basePrice: Int, quantity: Int) -> Int ! {} {
    basePrice * quantity
}

// Apply percentage discount
pub fn applyDiscount(amount: Int, percentOff: Int) -> Int ! {} {
    amount - (amount * percentOff / 100)
}

// Calculate tax
pub fn calculateTax(amount: Int, taxRate: Int) -> Int ! {} {
    amount * taxRate / 100
}

// Calculate total with discount and tax
pub fn calculateTotal(basePrice: Int, quantity: Int, discountPct: Int, taxRate: Int) -> Int ! {} {
    let subtotal: Int = basePrice * quantity
    let discounted: Int = subtotal - (subtotal * discountPct / 100)
    let tax: Int = discounted * taxRate / 100
    discounted + tax
}

// Demo: Widget at $10, qty 2, 5% discount, 10% tax
// Expected: (10 * 2) = 20, 5% off = 19, 10% tax = 1.9 ~ 1, total = 20
pub fn demoCalculation() -> Int ! {} {
    calculateTotal(1000, 2, 5, 10)
}
